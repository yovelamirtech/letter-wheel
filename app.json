{
  "expo": {
    "name": "גלגל מילים",
    "slug": "hebrew-word-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yovlezstudio.wordswheel",
      "appleTeamId": "FLVYDQ86T2",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "המידע ישמש כדי להציג לך פרסומות מותאמות יותר ולתמוך בפיתוח האפליקציה בחינם."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yovlezstudio.wordswheel",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "web3formsAccessKey": "3b4fedff-42d5-403c-a286-74981a5944d9"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4185202215539389~9185715672",
          "iosAppId": "ca-app-pub-4185202215539389~7600442310"
        }
      ],
      "expo-tracking-transparency"
    ]
  }
}
